# --- Postgres ---
POSTGRES_USER=zyra
POSTGRES_PASSWORD=changeme
POSTGRES_DB=zyraworks
DATABASE_URL=postgresql+psycopg2://zyra:changeme@postgres:5432/zyraworks

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- MinIO ---
MINIO_ROOT_USER=zyra_admin
MINIO_ROOT_PASSWORD=changeme
MINIO_ENDPOINT=minio:9000

# --- n8n ---
N8N_HOST=localhost

# --- LLM layer ---
# Cual usa el Orchestrator/agentes por defecto: deepseek | openai | anthropic
LLM_PROVIDER=deepseek

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
# Tu user id de Telegram (y el de quien mas autorices). Cualquier otro id es ignorado.
# Para obtener tu id: hablale a @userinfobot en Telegram.
TELEGRAM_ALLOWED_USER_IDS=

# --- Seguridad ---
# Si es true, ninguna accion que modifique algo (no solo consultas) se ejecuta sin
# confirmacion explicita del usuario en el propio chat de Telegram.
REQUIRE_APPROVAL_FOR_ACTIONS=true
